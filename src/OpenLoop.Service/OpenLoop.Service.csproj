<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>OpenLoop.Service</RootNamespace>
    <AssemblyName>OpenLoop.Service</AssemblyName>
    <Version>0.1.9</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLoop.Core\OpenLoop.Core.csproj" />
    <ProjectReference Include="..\..\..\PuppetCore\Puppet.Core\Puppet.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <InternalsVisibleTo Include="OpenLoop.Service.Tests" />
  </ItemGroup>

  <!-- 唯一的静态界面：随引用方（A/I）复制到各自输出目录的 wwwroot/。 -->
  <ItemGroup>
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
