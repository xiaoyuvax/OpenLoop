<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\ShellVersion.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>OpenLoop.App</RootNamespace>
    <AssemblyName>OpenLoop</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\OpenLoop.ico</ApplicationIcon>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\OpenLoop.ico" LogicalName="OpenLoop.App.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLoop.Core\OpenLoop.Core.csproj" />
    <ProjectReference Include="..\OpenLoop.Service\OpenLoop.Service.csproj" />
    <!-- 只为构建顺序：A/I 的可执行文件由下面的 CopyWorker 拷到 worker/，界面按同目录启动它们。 -->
    <ProjectReference Include="..\OpenLoop.A\OpenLoop.A.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\OpenLoop.I\OpenLoop.I.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\PuppetCore\Puppet.Core\Puppet.Core.csproj" />
    <ProjectReference Include="..\..\..\PuppetCore\Puppet.Core.WinForms\Puppet.Core.WinForms.csproj" />
  </ItemGroup>

  <Target Name="CopyWorker" AfterTargets="Build">
    <ItemGroup>
      <_WorkerFiles Include="..\OpenLoop.A\bin\$(Configuration)\net10.0\**\*" />
      <_WorkerFiles Include="..\OpenLoop.I\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <!-- 放进 worker/ 子目录：A/I 用它们自己那份依赖，不和界面的程序集互相覆盖。 -->
    <Copy SourceFiles="@(_WorkerFiles)"
          DestinationFiles="@(_WorkerFiles->'$(OutDir)worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="OpenLoop.Service.Config" />
    <Using Include="OpenLoop.Service.Models" />
    <Using Include="OpenLoop.Service.Logging" />
  </ItemGroup>

  <!-- ChatFlow 是同级组件仓库（开发态 ../../ChatFlow，安装态 source/ChatFlow），只走源码引用。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\ChatFlow\ChatFlow\ChatFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" />
    <!-- md 文件预览与 ChatFlow 用同一个渲染控件 -->
    <PackageReference Include="CDS.Markdown.Lite" />
  </ItemGroup>

</Project>
