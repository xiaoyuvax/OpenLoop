<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>OpenLoop.App</RootNamespace>
    <AssemblyName>OpenLoop</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\OpenLoop.ico</ApplicationIcon>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\OpenLoop.ico" LogicalName="OpenLoop.App.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLoop.Core\OpenLoop.Core.csproj" />
    <PackageReference Include="Puppet.Core" Version="1.6.1" />
    <PackageReference Include="Puppet.Core.WinForms" Version="1.6.1" />
  </ItemGroup>

  <!-- ChatFlow 源码与本仓库并列（../ChatFlow）时直接引用源码；单独克隆 OpenLoop 时回退到 NuGet 包。 -->
  <ItemGroup Condition="Exists('..\..\..\ChatFlow\ChatFlow\ChatFlow.csproj')">
    <ProjectReference Include="..\..\..\ChatFlow\ChatFlow\ChatFlow.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\ChatFlow\ChatFlow\ChatFlow.csproj')">
    <PackageReference Include="ChatFlow" Version="0.1.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.15" />
  </ItemGroup>

</Project>
